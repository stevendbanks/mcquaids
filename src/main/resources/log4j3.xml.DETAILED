<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="STDOUT" target="SYSTEM_OUT">
            <PatternLayout pattern="%d %-5p [%t] %c{1} (%F:%L) - %m%n"/>
        </Console>
    </Appenders>

    <Loggers>

        <!-- Turn up Struts core logging -->
        <Logger name="com.opensymphony.xwork2" level="debug" additivity="false">
            <AppenderRef ref="STDOUT"/>
        </Logger>

        <!-- OGNL conversion (critical for parameter binding errors) -->
        <Logger name="com.opensymphony.xwork2.ognl" level="debug" additivity="false">
            <AppenderRef ref="STDOUT"/>
        </Logger>

        <!-- Type conversion layer -->
        <Logger name="com.opensymphony.xwork2.util" level="debug" additivity="false">
            <AppenderRef ref="STDOUT"/>
        </Logger>

        <!-- ParametersInterceptor (this is the one throwing your warnings) -->
        <Logger name="com.opensymphony.xwork2.interceptor.ParametersInterceptor"
                level="debug" additivity="false">
            <AppenderRef ref="STDOUT"/>
        </Logger>

        <!-- Struts dispatcher -->
        <Logger name="org.apache.struts2.dispatcher" level="debug" additivity="false">
            <AppenderRef ref="STDOUT"/>
        </Logger>

        <!-- Tiles (optional) -->
        <Logger name="org.apache.tiles" level="info"/>

        <Root level="warn">
            <AppenderRef ref="STDOUT"/>
        </Root>
    </Loggers>
</Configuration>